[Unit]
Description=Email the Notizo operator about a failed backup check (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/push-notification-app/deploy/hostinger
ExecStart=/usr/bin/python3 /opt/push-notification-app/deploy/hostinger/ops_alert.py failure %i
TimeoutStartSec=60
