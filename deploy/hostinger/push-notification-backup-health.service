[Unit]
Description=Check Notizo backup freshness and retry operator email alerts
After=network-online.target
Wants=network-online.target
OnFailure=push-notification-ops-alert@monitor-failed.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/push-notification-app/deploy/hostinger
ExecStart=/usr/bin/python3 /opt/push-notification-app/deploy/hostinger/backup_health.py
TimeoutStartSec=3min
Nice=10
