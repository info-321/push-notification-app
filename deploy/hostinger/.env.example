# Copy to .env in THIS directory. Keep .env private (chmod 600 .env).
# Generate two different database passwords with: openssl rand -hex 32
DB_NAME=push_notifications
DB_USER=push_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Set the administrator login used for this dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Copy the EXACT value from the deployed Cloudways server/.env.
# Changing this value changes WordPress sender API keys.
PUSH_API_SECRET=
PUBLIC_API_BASE=https://push.micetraveladvisor.com
# Replace with your real contact email, preserving the mailto: prefix.
VAPID_SUBJECT=mailto:you@example.com
