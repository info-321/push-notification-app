# Copy to .env in THIS directory. Keep .env private (chmod 600 .env).
# Generate two different database passwords with: openssl rand -hex 32
DB_NAME=push_notifications
DB_USER=push_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Set the administrator login used for this dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Copy the EXACT value from the deployed Cloudways server/.env.
# Changing this value changes WordPress sender API keys.
PUSH_API_SECRET=
PUBLIC_API_BASE=https://push.micetraveladvisor.com
# Replace with your real contact email, preserving the mailto: prefix.
VAPID_SUBJECT=mailto:you@example.com

# Recovery email (disabled until SMTP credentials are configured privately).
# SMTP_FROM must be a mailbox/address verified by your email provider.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# HTTPS dashboard origin for verification/reset links; defaults to PUBLIC_API_BASE.
PUBLIC_DASHBOARD_BASE=
# Extra exact dashboard origins, comma-separated. No wildcard.
# For a local dashboard against the hosted API: http://localhost:3000
DASHBOARD_ORIGINS=
