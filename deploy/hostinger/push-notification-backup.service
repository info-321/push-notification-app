[Unit]
Description=Back up the push notification database and deployment configuration
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/push-notification-app/deploy/hostinger
ExecStart=/bin/bash /opt/push-notification-app/deploy/hostinger/backup.sh
Nice=10
TimeoutStartSec=20min
