PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD="replace-with-your-database-password"
DB_NAME=push_notifications
ADMIN_USERNAME=admin
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_API_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Local testing: http://localhost:5000. For WordPress, use your deployed HTTPS API URL.
PUBLIC_API_BASE=http://localhost:5000
VAPID_SUBJECT=mailto:admin@example.com

# Recovery email (disabled until SMTP credentials are configured privately).
# SMTP_FROM must be a mailbox/address verified by your email provider.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# HTTPS dashboard origin for verification/reset links; defaults to PUBLIC_API_BASE.
PUBLIC_DASHBOARD_BASE=
# Extra exact dashboard origins, comma-separated. No wildcard.
# For a local dashboard against the hosted API: http://localhost:3000
DASHBOARD_ORIGINS=
